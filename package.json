{
  "name": "reasonweave",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "A source-backed inquiry studio that makes learner reasoning visible.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "validate:local": "node scripts/validate-local.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:no-key": "playwright test -c playwright.no-key.config.ts",
    "evals:fixtures": "tsx evals/run-fixture-evals.ts",
    "evals:live": "tsx evals/run-live-evals.ts",
    "demo:capture": "node scripts/capture-seeded-demo.mjs",
    "demo:voices": "node scripts/list-elevenlabs-premade-voices.mjs",
    "demo:narrate": "node scripts/generate-elevenlabs-demo.mjs",
    "demo:assemble": "node scripts/build-demo-rehearsal.mjs",
    "media:render": "node scripts/render-release-media.mjs",
    "submission:preflight": "node scripts/submission-preflight.mjs",
    "performance:bundle": "node scripts/check-client-bundle.mjs",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run evals:fixtures"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "next": "16.2.10",
    "openai": "6.47.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
